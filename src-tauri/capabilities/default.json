{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas da janela principal (SEG-30)",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "allow-app-info",
    "allow-system-appearance",
    "allow-get-preferences",
    "allow-save-preferences",
    "allow-encryption-status",
    "allow-create-encryption-key",
    "allow-activate-encryption-key",
    "allow-import-encryption-key",
    "allow-list-accounts",
    "allow-add-local-account",
    "allow-remove-account",
    "allow-list-jobs",
    "allow-save-job",
    "allow-delete-job",
    "allow-preview-job",
    "allow-connect-google",
    "allow-list-remote",
    "allow-create-remote-folder",
    "allow-upload-file",
    "allow-download-file",
    "allow-download-and-extract",
    "allow-upload-compressed",
    "allow-run-job",
    "allow-cancel-run",
    "allow-job-status",
    "allow-refresh-job-status",
    "allow-list-versions",
    "allow-restore-version",
    "allow-compress-paths",
    "allow-extract-archive",
    "allow-cancel-archive"
  ]
}
